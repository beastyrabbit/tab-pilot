{
  "$schema": "https://t3.codes/schema/t3.json",
  "scripts": [
    {
      "name": "Set up worktree",
      "command": "corepack pnpm install --ignore-scripts --ignore-pnpmfile --frozen-lockfile",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Install dependencies",
      "command": "corepack pnpm install --frozen-lockfile",
      "icon": "configure"
    },
    {
      "name": "Build extension",
      "command": "corepack pnpm --filter @tab-orga/extension build",
      "icon": "build"
    },
    {
      "name": "Package extension",
      "command": "corepack pnpm --filter @tab-orga/extension build && node scripts/package-extension.mjs",
      "icon": "build"
    },
    {
      "name": "Check proxy",
      "command": "corepack pnpm run proxy:check",
      "icon": "test"
    },
    {
      "name": "Open extension",
      "command": "xdg-open apps/extension/dist",
      "icon": "play"
    }
  ]
}
