{
  "$schema": "https://t3.codes/schema/t3.json",
  "scripts": [
    {
      "name": "Set up worktree",
      "command": "pnpm install --ignore-scripts --ignore-pnpmfile --frozen-lockfile",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Build extension",
      "command": "pnpm run build:extension",
      "icon": "build"
    },
    {
      "name": "Package extension",
      "command": "pnpm run package:extension",
      "icon": "build"
    },
    {
      "name": "Check code",
      "command": "pnpm run lint && pnpm run typecheck:extension && pnpm test",
      "icon": "test"
    },
    {
      "name": "Watch extension",
      "command": "pnpm --filter @tab-orga/extension dev",
      "icon": "build",
      "stopOnSettle": true
    }
  ]
}
