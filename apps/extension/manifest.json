{
  "manifest_version": 3,
  "name": "Tab Organizer",
  "description": "AI-powered tab organizer that groups your browser tabs intelligently",
  "version": "0.1.0",
  "permissions": [
    "tabs",
    "tabGroups",
    "activeTab",
    "sidePanel",
    "scripting",
    "debugger",
    "favicon",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Open Tab Organizer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
