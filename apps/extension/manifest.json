{
  "manifest_version": 3,
  "name": "Tab Organizer",
  "description": "Organize Chrome tabs with a user-configured local AI proxy, protected groups, and a reviewable proposal.",
  "version": "0.3.1",
  "version_name": "0.3.1 standalone",
  "permissions": [
    "tabs",
    "tabGroups",
    "activeTab",
    "sidePanel",
    "scripting",
    "favicon",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Open Tab Organizer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
