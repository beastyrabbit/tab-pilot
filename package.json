{
  "name": "beasty-tab-orga",
  "private": true,
  "scripts": {
    "dev": "pnpm build:extension && pnpm dev:server",
    "dev:server": "pnpm --filter @tab-orga/server dev",
    "dev:extension": "pnpm --filter @tab-orga/extension dev",
    "build": "pnpm -r build",
    "build:server": "pnpm --filter @tab-orga/server build",
    "build:extension": "pnpm --filter @tab-orga/extension build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
