{
  "name": "beasty-tab-orga",
  "private": true,
  "scripts": {
    "install:all": "pnpm install",
    "build:extension": "pnpm --filter @tab-orga/extension build",
    "package:extension": "pnpm build:extension && node scripts/package-extension.mjs",
    "typecheck:extension": "pnpm --filter @tab-orga/extension typecheck",
    "proxy:check": "curl --fail --silent --show-error http://127.0.0.1:8317/v1/models",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
